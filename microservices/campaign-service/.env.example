# campaign-service configuration
PORT=2000
DATABASE_URL=postgresql+asyncpg://ndorsify:ndorsify@localhost:5432/campaigndb

# --- Auth ---
# MUST match users-service so access tokens verify here.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# Shared secret for internal calls this service makes (X-Service-Token).
SERVICE_TOKEN=dev-service-token-change-me
# collaboration-service base URL; when set, accepting an invitation/application
# creates a Collaboration there. Leave empty to disable.
COLLABORATION_URL=

# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000

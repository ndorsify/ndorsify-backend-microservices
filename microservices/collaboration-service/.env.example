# collaboration-service configuration
PORT=4000
DATABASE_URL=postgresql+asyncpg://ndorsify:ndorsify@localhost:5432/collaborationdb

# --- Auth ---
# MUST match users-service so access tokens verify here.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# Shared secret for the internal create endpoint (campaign-service calls it).
SERVICE_TOKEN=dev-service-token-change-me

# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000

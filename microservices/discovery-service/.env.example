# discovery-service configuration
PORT=9000
DATABASE_URL=postgresql+asyncpg://ndorsify:ndorsify@localhost:5432/discoverydb

# --- Auth ---
# MUST match users-service so access tokens verify here.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# Shared secret for the internal creator-index ingest (X-Service-Token).
SERVICE_TOKEN=dev-service-token-change-me

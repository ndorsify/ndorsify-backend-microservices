# profile-service configuration
PORT=6060
DATABASE_URL=postgresql+asyncpg://ndorsify:ndorsify@localhost:5432/profiledb

# --- Auth (P0) ---
# MUST match users-service so access tokens verify here.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256

# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000

# users-service configuration
PORT=1000
DATABASE_URL=postgresql+asyncpg://ndorsify:ndorsify@localhost:5432/usersdb

# --- Auth (P0) ---
# CHANGE THESE IN EVERY REAL ENVIRONMENT.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFY_TOKEN_HOURS=48
RESET_TOKEN_HOURS=2
# Shared secret for internal service-to-service calls (X-Service-Token header).
SERVICE_TOKEN=dev-service-token-change-me
# DEV/TEST ONLY: echo verify/reset tokens in responses (no email provider yet).
EXPOSE_DEV_TOKENS=false

# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "users": {
      "root": "microservices/users-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/users",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "campaigns": {
      "root": "microservices/campaign-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/campaigns",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "collab",
          "format": "url",
          "env": "COLLABORATION_URL"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "collab": {
      "root": "microservices/collaboration-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/collab",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "profiles": {
      "root": "microservices/profile-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/profiles",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "discovery",
          "format": "url",
          "env": "DISCOVERY_URL"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "discovery": {
      "root": "microservices/discovery-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/discovery",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "messaging": {
      "root": "microservices/messaging-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/messaging",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    },
    "content": {
      "root": "microservices/dynamic-content-service",
      "entrypoint": "app.main:app",
      "rewrites": [
        {
          "source": "/api/_health/content",
          "destination": "/health"
        },
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "buildCommand": "pip install -r requirements.txt && alembic upgrade head"
    }
  },
  "rewrites": [
    {
      "source": "/api/_health/users",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/_health/campaigns",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/_health/collab",
      "destination": {
        "service": "collab"
      }
    },
    {
      "source": "/api/_health/profiles",
      "destination": {
        "service": "profiles"
      }
    },
    {
      "source": "/api/_health/discovery",
      "destination": {
        "service": "discovery"
      }
    },
    {
      "source": "/api/_health/messaging",
      "destination": {
        "service": "messaging"
      }
    },
    {
      "source": "/api/_health/content",
      "destination": {
        "service": "content"
      }
    },
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/auth",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/users/(.*)",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/users",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/campaigns/(.*)",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/campaigns",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/applications/(.*)",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/applications",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/invitations/(.*)",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/invitations",
      "destination": {
        "service": "campaigns"
      }
    },
    {
      "source": "/api/collaborations/(.*)",
      "destination": {
        "service": "collab"
      }
    },
    {
      "source": "/api/collaborations",
      "destination": {
        "service": "collab"
      }
    },
    {
      "source": "/api/deliverables/(.*)",
      "destination": {
        "service": "collab"
      }
    },
    {
      "source": "/api/deliverables",
      "destination": {
        "service": "collab"
      }
    },
    {
      "source": "/api/profiles/(.*)",
      "destination": {
        "service": "profiles"
      }
    },
    {
      "source": "/api/profiles",
      "destination": {
        "service": "profiles"
      }
    },
    {
      "source": "/api/social/(.*)",
      "destination": {
        "service": "profiles"
      }
    },
    {
      "source": "/api/social",
      "destination": {
        "service": "profiles"
      }
    },
    {
      "source": "/api/discovery/(.*)",
      "destination": {
        "service": "discovery"
      }
    },
    {
      "source": "/api/discovery",
      "destination": {
        "service": "discovery"
      }
    },
    {
      "source": "/api/conversations/(.*)",
      "destination": {
        "service": "messaging"
      }
    },
    {
      "source": "/api/conversations",
      "destination": {
        "service": "messaging"
      }
    },
    {
      "source": "/api/onboard/(.*)",
      "destination": {
        "service": "content"
      }
    },
    {
      "source": "/api/onboard",
      "destination": {
        "service": "content"
      }
    },
    {
      "source": "/api/media/(.*)",
      "destination": {
        "service": "content"
      }
    },
    {
      "source": "/api/media",
      "destination": {
        "service": "content"
      }
    }
  ]
}
